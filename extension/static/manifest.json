{
  "manifest_version": 3,
  "name": "BetterTube",
  "version": "0.4.0",
  "description": "Fixes YouTube's watch page (normal view, resizable player, description under the video), a fast speed controller for every site, and watch stats.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BetterTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "speed-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN",
      "exclude_matches": [
        "*://*.netflix.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "speed.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://*.netflix.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
